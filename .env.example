# Client-side (exposed to browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (Vercel serverless functions)
SUPABASE_URL=          # Same value as VITE_SUPABASE_URL, for /api/* functions
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
JWT_SECRET=            # Random string: openssl rand -base64 32

# Pont FlashFWB — projet Supabase distinct (decks/cards), lié explicitement
# par l'enseignant (option 3). Ne jamais utiliser SUPABASE_SERVICE_ROLE_KEY
# ci-dessus pour ce projet : c'est un projet Supabase différent.
VITE_FLASHFWB_SUPABASE_URL=
VITE_FLASHFWB_SUPABASE_ANON_KEY=
FLASHFWB_SUPABASE_URL=          # Same value as VITE_FLASHFWB_SUPABASE_URL, for /api/* functions
FLASHFWB_SERVICE_ROLE_KEY=
